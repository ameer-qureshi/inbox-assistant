# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- Database ---
POSTGRES_DB=inbox
POSTGRES_USER=inbox
POSTGRES_PASSWORD=change-me-db-password

# --- First user (created at backend startup if missing) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
COOKIE_SECURE=false            # true when served over HTTPS

# --- n8n -> backend: shared secret, header X-Webhook-Secret ---
WEBHOOK_SECRET=change-me-openssl-rand-hex-32
# Bonus: HMAC-SHA256 of the exact body in X-Signature, on top of the shared secret.
# n8n signs every call with it and the backend then requires the signature.
# Leave empty to disable (the shared secret alone is then checked).
WEBHOOK_HMAC_SECRET=change-me-openssl-rand-hex-32

# --- backend -> n8n: "Send reply" webhook ---
# Empty = demo mode: replies are marked sent by a mock sender (no Gmail needed).
# With n8n: http://n8n:5678/webhook/send-reply
N8N_SEND_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=change-me-another-secret
# Demo mode only: share of simulated send failures, to try the Retry button (0 to 1)
MOCK_SEND_FAILURE_RATE=0

# --- AI (Groq) --- empty key = demo mode (template drafts, rule-based summary)
GROQ_API_KEY=
CLASSIFY_MODEL=openai/gpt-oss-20b
DRAFT_MODEL=openai/gpt-oss-120b

# --- Gmail OAuth (Google Cloud > Credentials > OAuth client "Web application") ---
# Redirect URI to register: http://localhost:5678/rest/oauth2-credential/callback
# Only read by n8n/setup_n8n.py, which loads them into n8n's encrypted credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- n8n ---
N8N_VERSION=1.123.62
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
