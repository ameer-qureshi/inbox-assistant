        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "489da057-c2fc-40d4-8494-c25dcbb053cb",
      "name": "Send batch to backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
