      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/webhooks/sync/{{ $('Start sync run').first().json.sync_run_id }}/complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'success', fetched_count: $('Collect message ids').first().json.count }) }}"
      },
      "id": "6eb999a5-d6be-470c-a0b7-1c666723012c",
      "name": "Complete sync run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "BackendWebhook01",
          "name": "Backend webhook secret"
        }
      },
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/webhooks/sync/{{ $json.sync_run_id }}/complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: \"success\", fetched_count: 0 }) }}"
      },
      "id": "4273ee31-bf89-472f-8631-a10835116d8f",
      "name": "Complete sync run (nothing new)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
