          "name": "Backend webhook secret"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "57c4d888-21a3-47dc-8406-e5dfe409680d",
              "leftValue": "={{ $json.claimed }}",
