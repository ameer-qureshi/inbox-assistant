{
  "id": "InboxSendWf00003",
  "name": "3 - Send reply",
  "nodes": [
    {
      "parameters": {
        "content": "## Send reply\nCalled only by the backend (shared secret in `X-Webhook-Secret`), never by the website.\n\n1. Claim the attempt: if this exact attempt was already picked up, stop (no double send).\n2. Build the MIME message with In-Reply-To/References and the Gmail threadId, so it lands in the same thread.\n3. Send, then report `sent` (with the Gmail id) or `failed` to the backend. The UI then shows Retry.",
        "height": 300,
        "width": 380
      },
      "id": "2d5e6ddf-a2cb-43a0-9016-ae5fa5fba34b",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-reply",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "4b02b220-d02a-4793-bdce-8ae0050d6bfc",
      "name": "Reply requested by backend",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "N8nSendSecret001",
          "name": "Send-reply webhook secret"
        }
      },
      "webhookId": "1c0e1333-034c-4a20-9521-8235c83782a3"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/webhooks/replies/{{ $('Reply requested by backend').first().json.body.reply_id }}/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ attempt: $('Reply requested by backend').first().json.body.attempt }) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Signature",
              "value": "=sha256={{ $json._signature }}"
            }
          ]
        }
      },
