          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "88745413-6ca3-4d95-9519-adae240aef79",
      "name": "Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build an RFC 2822 message that Gmail attaches to the original thread:\n// same threadId + In-Reply-To/References headers + \"Re:\" subject.\nconst p = $('Reply requested by backend').first().json.body;\nconst oneLine = s => String(s || '').replace(/[\\r\\n]+/g, ' ').trim();   // no header injection\nconst encodeWord = s => /^[\\x00-\\x7F]*$/.test(s) ? s : '=?UTF-8?B?' + Buffer.from(s, 'utf8').toString('base64') + '?=';\nconst lines = [\n  `To: ${oneLine(p.to)}`,\n  `Subject: ${encodeWord(oneLine(p.subject))}`,\n  p.in_reply_to ? `In-Reply-To: ${oneLine(p.in_reply_to)}` : null,\n  p.references ? `References: ${oneLine(p.references)}` : null,\n  'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=\"UTF-8\"',\n  'Content-Transfer-Encoding: base64',\n  '',\n  Buffer.from(String(p.body), 'utf8').toString('base64').replace(/(.{76})/g, '$1\\r\\n'),\n].filter(l => l !== null);\nconst raw = Buffer.from(lines.join('\\r\\n'), 'utf8').toString('base64')\n  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\nreturn [{ json: { raw, threadId: p.gmail_thread_id } }];\n"
      },
      "id": "be9ef166-2320-47fd-b07b-1dca9f707c92",
      "name": "Build email (same thread)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
